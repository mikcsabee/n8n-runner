{
  "name": "n8n-runner",
  "version": "0.0.6",
  "description": "n8n workflow runner library",
  "author": "Csaba Miklos",
  "keywords": [
    "n8n",
    "workflow",
    "automation",
    "runner",
    "executor"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mikcsabee/n8n-runner.git"
  },
  "bugs": {
    "url": "https://github.com/mikcsabee/n8n-runner/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "lint": "biome lint src/",
    "lint:fix": "biome lint src/ --write",
    "format": "biome format src/",
    "format:fix": "biome format src/ --write",
    "check": "biome check src/",
    "check:fix": "biome check src/ --write",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "license": "MIT",
  "dependencies": {
    "@n8n/backend-common": "1.40.1",
    "@n8n/di": "0.17.0",
    "n8n-core": "2.40.3",
    "n8n-workflow": "2.40.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.3",
    "jest": "30.5.2",
    "ts-jest": "29.4.14",
    "typescript": "6.0.3"
  }
}
